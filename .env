WARDEN_ENV_NAME=wordpressbloks
WARDEN_ENV_TYPE=wordpress
WARDEN_WEB_ROOT=/

TRAEFIK_DOMAIN=wordpress-blocks.test
TRAEFIK_SUBDOMAIN=

WARDEN_DB=1
WARDEN_REDIS=0
WARDEN_ELASTICSEARCH=0
WARDEN_OPENSEARCH=0
WARDEN_VARNISH=0
WARDEN_RABBITMQ=0
WARDEN_DB_PORT=3306
WARDEN_DOCKER_COMPOSE_OVERRIDE=.warden/docker-compose.db-ports.yml

MYSQL_DISTRIBUTION=mariadb
MYSQL_DISTRIBUTION_VERSION=10.6

NODE_VERSION=20
COMPOSER_VERSION=2
PHP_VERSION=8.2
PHP_XDEBUG_3=1

NGINX_VERSION=1.24

WARDEN_SYNC_IGNORE=
WARDEN_FORCE_DEBUG=